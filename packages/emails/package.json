{
  "name": "@accordo/emails",
  "version": "0.0.0",
  "private": true,
  "description": "React Email templates",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@accordo/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

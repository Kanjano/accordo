# Production example (docker-compose.prod.example.yml). Copy to infra/compose/.env.prod (ignored
# by git) and replace every "change-me": `openssl rand -base64 32` for secrets.
DOMAIN=accordo.localhost
ACME_EMAIL=admin@example.com

# PostgreSQL: superuser only for the first initialisation, then the two roles below.
POSTGRES_PASSWORD=change-me-postgres
MIGRATOR_PASSWORD=change-me-migrator
APP_PASSWORD=change-me-app

MEILI_MASTER_KEY=change-me-meili-master-key-32-chars
S3_ACCESS_KEY_ID=accordo
S3_SECRET_ACCESS_KEY=change-me-s3-secret

BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
DEVICE_COOKIE_SECRET=change-me-at-least-32-characters-long
HANDOVER_CODE_PEPPER=change-me-pepper
# 32 random bytes, base64.
ENCRYPTION_KEY=change-me
ENCRYPTION_KEY_ID=k1

EMAIL_FROM=Accordo <no-reply@accordo.localhost>
SMTP_HOST=mailpit
SMTP_PORT=1025

# Test/sandbox providers on staging; live keys only in production.
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=
SHIPPING_API_SECRET=
SHIPPING_WEBHOOK_SECRET=change-me-shipping-webhook
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
